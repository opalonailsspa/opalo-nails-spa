# ============================================================================
# ÓPALO NAILS SPA - PLANTILLA DE VARIABLES DE ENTORNO (.env.example)
# ============================================================================
# Copia este archivo como `.env` en `/backend` (y configura estas variables en
# Render / Vercel) con las credenciales de la nueva cuenta de Ópalo Nails Spa.

# --- 1. SERVIDOR Y PUERTO ---
PORT=3000

# URL pública del frontend desplegado en Vercel (ej: https://opalo-nails-spa.vercel.app)
FRONTEND_URL=

# --- 2. SUPABASE (BASE DE DATOS Y TIEMPO REAL) ---
# URL del proyecto en Supabase (Settings -> API -> Project URL)
SUPABASE_URL=

# Service Role Key de Supabase para el backend (Settings -> API -> service_role secret)
SUPABASE_SERVICE_ROLE_KEY=

# Variables públicas de Supabase para el Frontend (Vite / Vercel)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# --- 3. INTELIGENCIA ARTIFICIAL (GOOGLE GEMINI) ---
# API Key de Google AI Studio para el recepcionista IA y lector de comprobantes
GEMINI_API_KEY=

# --- 4. WHATSAPP BOT (BAILEYS) ---
# Proveedor activo de WhatsApp ('baileys' para conexión directa mediante código QR)
WHATSAPP_PROVIDER=baileys

# Permitir atención automática a todos los números entrantes (true/false)
BAILEYS_ALLOW_ALL=true

# Lista blanca de números permitidos ('*' para atender a todas las clientas)
BAILEYS_WHITELIST_NUMBERS=*
