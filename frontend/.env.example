# ============================================================================
# ÓPALO NAILS SPA (FRONTEND - VITE / VERCEL) - PLANTILLA DE VARIABLES DE ENTORNO
# ============================================================================
# Configura estas variables en Vercel (Project Settings -> Environment Variables)
# o en un archivo `.env` dentro de `/frontend`.

# URL del proyecto de Supabase (Project Settings -> API -> Project URL)
VITE_SUPABASE_URL=

# Anon / Public Key del proyecto de Supabase (Project Settings -> API -> anon public)
VITE_SUPABASE_ANON_KEY=
