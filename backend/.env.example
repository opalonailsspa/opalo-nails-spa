# ============================================================================
# ÓPALO NAILS SPA (BACKEND) - PLANTILLA DE VARIABLES DE ENTORNO
# ============================================================================
# Copia este archivo como `.env` en `/backend` o configura estas variables en
# el panel de Render para la cuenta de Ópalo Nails Spa.

# --- 1. SERVIDOR Y FRONTEND ---
PORT=3000
FRONTEND_URL=

# --- 2. SUPABASE (BASE DE DATOS) ---
# Obtén estos valores en tu nuevo proyecto de Supabase -> Project Settings -> API
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# --- 3. GOOGLE GEMINI AI (RECEPCIONISTA Y VERIFICACIÓN DE COMPROBANTES) ---
# Obtén tu llave en https://aistudio.google.com/
GEMINI_API_KEY=

# --- 4. WHATSAPP BOT (BAILEYS QR) ---
WHATSAPP_PROVIDER=baileys
BAILEYS_ALLOW_ALL=true
BAILEYS_WHITELIST_NUMBERS=*
